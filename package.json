{
  "name": "penguinmod-desktop",
  "author": "FreshPenguin112 <freshpenguin112@gmail.com>",
  "description": "A Windows desktop app for the PenguinMod editor",
  "version": "1.0.0",
  "main": "app/electron-main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "build:fast": "electron-builder --config.compression=store --publish never --dir"
  },
  "build": {
    "appId": "com.penguinmod.desktop",
    "productName": "PenguinMod Desktop",
    "fileAssociations": [
      {
        "ext": "pmp",
        "name": "Penguinmod Project",
        "description": "Penguinmod Project File",
        "mimeType": "application/x-pmp",
        "icon": "app/logo.ico"
      }
    ],
    "directories": {
      "output": "builds"
    },
    "files": [
      "app/**/*"
    ],
    "extraResources": [
      {
        "from": "offline-library",
        "to": "offline-library"
      },
      {
        "from": "packager-electron",
        "to": "packager-electron"
      }
    ],
    "compression": "maximum",
    "publish": null,
    "buildDependenciesFromSource": false,
    "asar": false,
    "npmRebuild": false,
    "nodeGypRebuild": false,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "signAndEditExecutable": true,
      "verifyUpdateCodeSignature": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "PenguinMod Desktop"
    }
  },
  "devDependencies": {
    "electron": "44.6.0",
    "electron-builder": "26.15.3"
  },
  "dependencies": {
    "unzipper": "^0.12.3"
  }
}
